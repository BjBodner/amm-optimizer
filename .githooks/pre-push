#!/bin/sh
# Optional local gate before every push. NOT active by default.
#   enable : git config core.hooksPath .githooks
#   disable: git config --unset core.hooksPath
#   skip once: git push --no-verify
# Runs the research tier (a few minutes); run `python tools/ci.py --tier merge` before
# merging to main and `--tier full` before a release.
cd "$(git rev-parse --show-toplevel)" || exit 1
for py in .venv/Scripts/python.exe .venv/bin/python python; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then exec "$py" tools/ci.py; fi
done
echo "pre-push: no Python found" >&2
exit 1
